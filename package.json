{
  "name": "@steamharness/monorepo",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "check:skill-copies": "node scripts/check-skill-copies.mjs",
    "check:vendor-copies": "node scripts/check-vendor-copies.mjs",
    "test:scripts": "node --test --test-reporter=spec scripts/__tests__/*.test.mjs",
    "check": "pnpm check:skill-copies && pnpm check:vendor-copies && pnpm test:scripts",
    "typecheck": "pnpm -r --filter \"./shared/*\" --filter \"./harness\" --filter \"./cli\" --filter \"./server\" run typecheck",
    "test": "pnpm -r --filter \"./shared/*\" --filter \"./harness\" --filter \"./cli\" --filter \"./build-in/*\" run test",
    "build": "pnpm -r --filter \"./shared/*\" --filter \"./harness\" --filter \"./cli\" --filter \"./server\" run build",
    "server:dev": "pnpm -C server dev",
    "server:start": "pnpm -C server start:local",
    "studio:dev": "pnpm -C studio run dev",
    "studio:web": "pnpm -C studio run dev:web",
    "doc:dev": "pnpm -C docs site:dev"
  }
}
