{
  "name": "studio-workstation",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "studio",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.140.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "browser": "./dist/extension-web.js",
  "l10n": "./l10n",
  "activationEvents": ["onStartupFinished", "onWebviewPanel:studio.project", "onCommand:studio.internalStartPageVisibility"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": { "supported": true }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "studio.documentPreview", "displayName": "%editor.documentPreview%", "priority": "default",
        "selector": [
          { "filenamePattern": "*.pdf" }, { "filenamePattern": "*.docx" }, { "filenamePattern": "*.pptx" }, { "filenamePattern": "*.xlsx" },
          { "filenamePattern": "*.heic" }, { "filenamePattern": "*.heif" },
          { "filenamePattern": "*.png" }, { "filenamePattern": "*.jpg" }, { "filenamePattern": "*.jpeg" }, { "filenamePattern": "*.jfif" },
          { "filenamePattern": "*.gif" }, { "filenamePattern": "*.webp" }, { "filenamePattern": "*.bmp" }, { "filenamePattern": "*.avif" },
          { "filenamePattern": "*.ico" }, { "filenamePattern": "*.svg" }
        ]
      },
      {
        "viewType": "studio.formulaPreview", "displayName": "%editor.formulaPreview%", "priority": "default",
        "selector": [{ "filenamePattern": "*.tex" }, { "filenamePattern": "*.latex" }]
      }
    ],
    "authentication": [{ "id": "studio-steamharness", "label": "SteamHarness" }],
    "commands": [
      { "command": "studio.toggleMode", "title": "%command.toggleMode%", "category": "Studio", "enablement": "studio.projectAvailable || studio.steamMode" },
      { "command": "studio.enterIdeMode", "title": "%command.enterIdeMode%", "category": "Studio", "enablement": "studio.steamMode" },
      { "command": "studio.enterSteamMode", "title": "%command.enterSteamMode%", "category": "Studio", "enablement": "studio.projectAvailable" },
      { "command": "studio.openSteamTools", "title": "%command.openSteamTools%", "category": "Studio", "enablement": "studio.steamMode" },
      { "command": "studio.context.retry", "title": "%context.retry%", "category": "Studio" },
      { "command": "studio.context.open", "title": "%context.open%", "category": "Studio" },
      { "command": "studio.context.edit", "title": "%context.edit%", "category": "Studio" },
      { "command": "studio.context.delete", "title": "%context.delete%", "category": "Studio" },
      { "command": "studio.context.newKey", "title": "%context.newKey%", "category": "Studio" },
      { "command": "studio.context.newDocument", "title": "%context.newDocument%", "category": "Studio" },
      { "command": "studio.context.refresh", "title": "%context.refresh%", "category": "Studio" },
      { "command": "studio.context.copy", "title": "%context.copy%", "category": "Studio" },
      { "command": "studio.context.copyKey", "title": "%context.copyKey%", "category": "Studio" },
      { "command": "studio.context.copyId", "title": "%context.copyId%", "category": "Studio" },
      { "command": "studio.context.copyContent", "title": "%context.copyContent%", "category": "Studio" },
      { "command": "studio.context.copyRecord", "title": "%context.copyRecord%", "category": "Studio" },
      { "command": "studio.context.copyVersion", "title": "%context.copyVersion%", "category": "Studio" },
      { "command": "studio.context.copyHash", "title": "%context.copyHash%", "category": "Studio" },
      { "command": "studio.context.copyReleaseNotes", "title": "%context.copyReleaseNotes%", "category": "Studio" },
      { "command": "studio.context.download", "title": "%context.download%", "category": "Studio" },
      { "command": "studio.context.openSource", "title": "%context.openSource%", "category": "Studio" },
      { "command": "studio.context.expand", "title": "%context.expand%", "category": "Studio" },
      { "command": "studio.context.collapse", "title": "%context.collapse%", "category": "Studio" },
      { "command": "studio.context.signIn", "title": "%context.signIn%", "category": "Studio" },
      { "command": "studio.context.signOut", "title": "%context.signOut%", "category": "Studio" },
      { "command": "studio.context.editProfile", "title": "%context.editProfile%", "category": "Studio" },
      { "command": "studio.context.manageSessions", "title": "%context.manageSessions%", "category": "Studio" },
      { "command": "studio.openStart", "title": "%command.openStart%", "category": "Studio", "icon": "$(home)" },
      { "command": "studio.createProject", "title": "%command.createProject%", "category": "Studio", "icon": "$(new-file)" },
      { "command": "studio.createExample", "title": "%command.createExample%", "category": "Studio", "icon": "$(beaker)" },
      { "command": "studio.refreshStart", "title": "%command.refreshStart%", "category": "Studio", "icon": "$(refresh)" },
      { "command": "studio.openDocumentPreview", "title": "%command.openDocumentPreview%", "category": "Studio", "icon": "$(open-preview)" },
      { "command": "studio.refreshDocumentPreview", "title": "%command.refreshDocumentPreview%", "category": "Studio", "icon": "$(refresh)" },
      { "command": "studio.openFolder", "title": "%command.openFolder%", "category": "Studio", "icon": "$(folder-opened)" },
      { "command": "studio.openWorkspace", "title": "%command.openWorkspace%", "category": "Studio", "icon": "$(file-submodule)" },
      { "command": "studio.newFile", "title": "%command.newFile%", "category": "Studio", "icon": "$(new-file)" },
      { "command": "studio.openTerminal", "title": "%command.openTerminal%", "category": "Studio", "icon": "$(terminal)" },
      { "command": "studio.runTask", "title": "%command.runTask%", "category": "Studio", "icon": "$(play)" },
      { "command": "studio.openSettings", "title": "%command.openSettings%", "category": "Studio", "icon": "$(settings-gear)" },
      { "command": "studio.refreshProjects", "title": "%command.refreshProjects%", "category": "Studio", "icon": "$(refresh)" },
      { "command": "studio.openRecentProject", "title": "%command.openRecentProject%", "category": "Studio" },
      { "command": "studio.removeRecentProject", "title": "%command.removeRecentProject%", "category": "Studio", "icon": "$(close)" },
      { "command": "studio.clearRecentProjects", "title": "%command.clearRecentProjects%", "category": "Studio", "icon": "$(clear-all)" },
      { "command": "studio.openProject", "title": "%command.openProject%", "category": "Project", "icon": "$(play)" },
      { "command": "studio.uploadProject", "title": "%command.uploadProject%", "category": "Project", "icon": "$(cloud-upload)" },
      { "command": "studio.upgradeProject", "title": "%command.upgradeProject%", "category": "Project", "icon": "$(arrow-circle-up)" },
      { "command": "studio.downloadProject", "title": "%command.downloadProject%", "category": "Project", "icon": "$(cloud-download)" },
      { "command": "studio.importProjectFromLink", "title": "%command.importProjectFromLink%", "category": "Project", "icon": "$(link)" },
      { "command": "studio.refreshVersions", "title": "%command.refreshVersions%", "category": "Project", "icon": "$(refresh)" },
      { "command": "studio.openAnalysis", "title": "%command.openAnalysis%", "category": "Project", "icon": "$(graph)" },
      { "command": "studio.openAssistant", "title": "%command.openAssistant%", "category": "Project", "icon": "$(hubot)" },
      { "command": "studio.newAssistantConversation", "title": "%command.newAssistantConversation%", "category": "Project", "icon": "$(edit)" },
      { "command": "studio.searchAssistantConversations", "title": "%command.searchAssistantConversations%", "category": "Project", "icon": "$(search)" },
      { "command": "studio.refreshProjectView", "title": "%command.refreshProjectView%", "category": "Project", "icon": "$(refresh)" },
      { "command": "studio.refreshResources", "title": "%command.refreshResources%", "category": "Project", "icon": "$(refresh)" },
      { "command": "studio.selectInfoProject", "title": "%command.selectInfoProject%", "category": "Project", "icon": "$(list-selection)" },
      { "command": "studio.openInfoProjectSource", "title": "%command.openInfoProjectSource%", "category": "Project", "icon": "$(json)" },
      { "command": "studio.copyProjectInfoValue", "title": "%command.copyProjectInfoValue%", "category": "Project", "icon": "$(copy)" },
      { "command": "studio.openRelatedProject", "title": "%command.openRelatedProject%", "category": "Project", "icon": "$(link-external)" },
      { "command": "studio.refreshRelatedProjects", "title": "%command.refreshRelatedProjects%", "category": "Project", "icon": "$(refresh)" },
      { "command": "studio.openProjectSource", "title": "%command.openProjectSource%", "category": "Project", "icon": "$(code)" },
      { "command": "studio.openProjectDemo", "title": "%command.openProjectDemo%", "category": "Project", "icon": "$(comment-discussion)" },
      { "command": "studio.openProjectCli", "title": "%command.openProjectCli%", "category": "Project", "icon": "$(terminal)" },
      { "command": "studio.openAccount", "title": "%command.openProjectAccount%", "category": "SteamHarness", "icon": "$(account)" },
      { "command": "studio.refreshAccount", "title": "%command.refreshAccount%", "category": "SteamHarness", "icon": "$(refresh)" },
      { "command": "studio.validateLogin", "title": "%command.validateProjectLogin%", "category": "Project", "icon": "$(verified)" },
      { "command": "studio.logout", "title": "%command.logoutProject%", "category": "Project", "icon": "$(sign-out)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "studio-info", "title": "%container.studio-info%", "icon": "$(package)" },
        { "id": "studio-versions", "title": "%container.studio-versions%", "icon": "$(versions)" }
      ],
      "secondarySidebar": [{ "id": "studio-assistant", "title": "%container.studio-assistant%", "icon": "$(hubot)" }],
      "panel": [
        { "id": "studio-kv", "title": "KV", "icon": "$(database)" },
        { "id": "studio-knowledge", "title": "%container.studio-knowledge%", "icon": "$(book)" },
        { "id": "studio-trace", "title": "%container.studio-trace%", "icon": "$(history)" }
      ]
    },
    "views": {
      "explorer": [{ "id": "studio.relatedProjects", "name": "%view.studio.relatedProjects%", "icon": "$(references)", "when": "studio.projectInfoAvailable" }],
      "studio-info": [{ "id": "studio.projectInfo", "name": "%container.studio-info%", "type": "webview", "when": "studio.projectInfoAvailable" }],
      "studio-versions": [{ "id": "studio.versions", "name": "%container.studio-versions%", "type": "webview" }],
      "studio-assistant": [{ "id": "studio.developerAssistant", "name": "%container.studio-assistant%", "type": "webview" }],
      "studio-kv": [{ "id": "studio.kv", "name": "KV", "type": "webview", "when": "studio.projectResourcesAvailable" }],
      "studio-knowledge": [{ "id": "studio.knowledge", "name": "%container.studio-knowledge%", "type": "webview", "when": "studio.projectResourcesAvailable" }],
      "studio-trace": [{ "id": "studio.trace", "name": "%container.studio-trace%", "type": "webview", "when": "studio.projectTraceAvailable" }]
    },
    "menus": {
      "webview/context": [
        { "command": "studio.context.retry", "when": "studioContextMenu && studioContextAction_retry", "group": "1_navigation@22" },
        { "command": "editor.action.clipboardCopyAction", "when": "studioFrameSelection && preventDefaultContextMenuItems", "group": "2_clipboard" },
        { "command": "studio.context.open", "when": "studioContextMenu && studioContextAction_open", "group": "1_navigation@0" },
        { "command": "studio.context.edit", "when": "studioContextMenu && studioContextAction_edit", "group": "1_navigation@1" },
        { "command": "studio.context.delete", "when": "studioContextMenu && studioContextAction_delete", "group": "9_modify@2" },
        { "command": "studio.context.newKey", "when": "studioContextMenu && studioContextAction_newKey", "group": "1_navigation@3" },
        { "command": "studio.context.newDocument", "when": "studioContextMenu && studioContextAction_newDocument", "group": "1_navigation@4" },
        { "command": "studio.context.refresh", "when": "studioContextMenu && studioContextAction_refresh", "group": "1_navigation@5" },
        { "command": "studio.context.copy", "when": "studioContextMenu && studioContextAction_copy", "group": "2_clipboard@6" },
        { "command": "studio.context.copyKey", "when": "studioContextMenu && studioContextAction_copyKey", "group": "2_clipboard@7" },
        { "command": "studio.context.copyId", "when": "studioContextMenu && studioContextAction_copyId", "group": "2_clipboard@8" },
        { "command": "studio.context.copyContent", "when": "studioContextMenu && studioContextAction_copyContent", "group": "2_clipboard@9" },
        { "command": "studio.context.copyRecord", "when": "studioContextMenu && studioContextAction_copyRecord", "group": "2_clipboard@10" },
        { "command": "studio.context.copyVersion", "when": "studioContextMenu && studioContextAction_copyVersion", "group": "2_clipboard@11" },
        { "command": "studio.context.copyHash", "when": "studioContextMenu && studioContextAction_copyHash", "group": "2_clipboard@12" },
        { "command": "studio.context.copyReleaseNotes", "when": "studioContextMenu && studioContextAction_copyReleaseNotes", "group": "2_clipboard@13" },
        { "command": "studio.context.download", "when": "studioContextMenu && studioContextAction_download", "group": "1_navigation@14" },
        { "command": "studio.context.openSource", "when": "studioContextMenu && studioContextAction_openSource", "group": "1_navigation@15" },
        { "command": "studio.context.expand", "when": "studioContextMenu && studioContextAction_expand", "group": "1_navigation@16" },
        { "command": "studio.context.collapse", "when": "studioContextMenu && studioContextAction_collapse", "group": "1_navigation@17" },
        { "command": "studio.context.signIn", "when": "studioContextMenu && studioContextAction_signIn", "group": "1_navigation@18" },
        { "command": "studio.context.signOut", "when": "studioContextMenu && studioContextAction_signOut", "group": "9_modify@19" },
        { "command": "studio.context.editProfile", "when": "studioContextMenu && studioContextAction_editProfile", "group": "1_navigation@20" },
        { "command": "studio.context.manageSessions", "when": "studioContextMenu && studioContextAction_manageSessions", "group": "1_navigation@21" }
      ],
      "explorer/context": [
        { "command": "studio.openDocumentPreview", "when": "!explorerResourceIsFolder && resourceExtname =~ /\\.(pdf|docx|pptx|xlsx|tex|latex|png|jpe?g|jfif|gif|webp|bmp|avif|svg|ico|heic|heif)$/i", "group": "navigation@2" }
      ],
      "commandPalette": [
        { "command": "studio.toggleMode", "when": "studio.projectAvailable || studio.steamMode" },
        { "command": "studio.enterIdeMode", "when": "studio.steamMode" },
        { "command": "studio.enterSteamMode", "when": "studio.projectAvailable" },
        { "command": "studio.openSteamTools", "when": "studio.steamMode" },
        { "command": "studio.context.retry", "when": "false" },
        { "command": "studio.context.open", "when": "false" },
        { "command": "studio.context.edit", "when": "false" },
        { "command": "studio.context.delete", "when": "false" },
        { "command": "studio.context.newKey", "when": "false" },
        { "command": "studio.context.newDocument", "when": "false" },
        { "command": "studio.context.refresh", "when": "false" },
        { "command": "studio.context.copy", "when": "false" },
        { "command": "studio.context.copyKey", "when": "false" },
        { "command": "studio.context.copyId", "when": "false" },
        { "command": "studio.context.copyContent", "when": "false" },
        { "command": "studio.context.copyRecord", "when": "false" },
        { "command": "studio.context.copyVersion", "when": "false" },
        { "command": "studio.context.copyHash", "when": "false" },
        { "command": "studio.context.copyReleaseNotes", "when": "false" },
        { "command": "studio.context.download", "when": "false" },
        { "command": "studio.context.openSource", "when": "false" },
        { "command": "studio.context.expand", "when": "false" },
        { "command": "studio.context.collapse", "when": "false" },
        { "command": "studio.context.signIn", "when": "false" },
        { "command": "studio.context.signOut", "when": "false" },
        { "command": "studio.context.editProfile", "when": "false" },
        { "command": "studio.context.manageSessions", "when": "false" },
        { "command": "studio.refreshDocumentPreview", "when": "activeCustomEditorId == studio.documentPreview || activeCustomEditorId == studio.formulaPreview" }
      ],
      "view/title": [
        { "command": "studio.refreshVersions", "when": "view == studio.versions", "group": "navigation@1" },
        { "command": "studio.downloadProject", "when": "view == studio.versions", "group": "navigation@2" },
        { "command": "studio.refreshRelatedProjects", "when": "view == studio.relatedProjects", "group": "navigation" },
        { "command": "studio.selectInfoProject", "when": "view == studio.projectInfo && studio.projectInfoMultipleProjects", "group": "navigation@1" },
        { "command": "studio.openInfoProjectSource", "when": "view == studio.projectInfo", "group": "navigation@2" },
        { "command": "studio.refreshProjectView", "when": "view == studio.projectInfo", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "studio.openRelatedProject", "when": "view == studio.relatedProjects && viewItem == studio.relatedProjectImported", "group": "inline" }
      ],
      "editor/title": [
        { "command": "studio.refreshDocumentPreview", "when": "activeCustomEditorId == studio.documentPreview || activeCustomEditorId == studio.formulaPreview", "group": "navigation@1" },
        { "command": "studio.openDocumentPreview", "when": "resourceExtname =~ /\\.(tex|latex)$/i && activeCustomEditorId != studio.formulaPreview", "group": "navigation@1" },
        { "command": "studio.openProject", "when": "studio.projectAvailable", "group": "navigation@0" }
      ]
    },
    "configuration": {
      "title": "Studio",
      "properties": {
        "studio.startPage.enabled": {
          "type": "boolean", "default": true, "description": "%config.startPage.enabled%"
        },
        "studio.project.serverUrl": {
          "type": "string", "default": "http://localhost:7126", "scope": "application",
          "description": "%config.studio.project.serverUrl%"
        },
        "studio.project.nodePath": {
          "type": "string", "default": "", "scope": "machine", "restricted": true,
          "description": "%config.studio.project.nodePath%"
        },
        "studio.recentProjects.limit": {
          "type": "integer", "default": 12, "minimum": 1, "maximum": 50,
          "description": "%config.recentProjects.limit%", "scope": "application"
        },
        "studio.terminal.name": {
          "type": "string", "default": "Studio", "minLength": 1,
          "description": "%config.terminal.name%"
        }
      }
    },
    "configurationDefaults": {
      "workbench.iconTheme": "file-icons",
      "window.autoDetectColorScheme": true,
      "chat.disableAIFeatures": true,
      "workbench.startupEditor": "none",
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "window.title": "${dirty}${activeEditorShort}${separator}${rootName}${separator}${appName}"
    }
  }
}
