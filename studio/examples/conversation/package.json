{
  "id": "b20a7d1d-b6f5-4b0c-8589-265d56fc879a",
  "name": "Studio Conversation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "devDependencies": {
    "steamharness": "0.1.2",
    "@steamharness/cli": "0.1.2"
  },
  "steamHarness": {
    "projectInfo": {
      "localizedNames": {
        "zh-CN": "对话示例",
        "en": "Local Conversation Demo"
      },
      "platformSupport": {
        "mode": "agnostic"
      }
    },
    "entries": [
      {
        "entryId": "main",
        "type": "conversation",
        "name": "Studio Conversation",
        "root": ".",
        "entry": "index.ts",
        "databases": [
          {
            "alias": "data",
            "host": "local",
            "permissions": {
              "kv": {
                "read": {
                  "mode": "all"
                },
                "write": {
                  "mode": "all"
                }
              },
              "knowledge": {
                "read": {
                  "mode": "all"
                },
                "write": {
                  "mode": "all"
                }
              }
            }
          }
        ]
      }
    ],
    "defaultEntry": "main"
  }
}
