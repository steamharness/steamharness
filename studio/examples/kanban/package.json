{
  "id": "2bf9074d-ef0b-43b2-84c4-f379f920db92",
  "name": "Studio Kanban",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "devDependencies": {
    "steamharness": "0.1.2",
    "@steamharness/cli": "0.1.2"
  },
  "steamHarness": {
    "projectInfo": {
      "localizedNames": {
        "zh-CN": "看板示例",
        "en": "Local Kanban Demo"
      },
      "platformSupport": {
        "mode": "agnostic"
      }
    },
    "entries": [
      {
        "entryId": "main",
        "type": "kanban",
        "name": "Studio Kanban",
        "root": ".",
        "entry": "index.html",
        "databases": [
          {
            "alias": "data",
            "host": "local",
            "permissions": {
              "kv": {
                "read": {
                  "mode": "all"
                },
                "write": {
                  "mode": "all"
                }
              },
              "knowledge": {
                "read": {
                  "mode": "all"
                },
                "write": {
                  "mode": "all"
                }
              }
            }
          }
        ],
        "configuration": "configuration.json"
      }
    ],
    "defaultEntry": "main"
  }
}
