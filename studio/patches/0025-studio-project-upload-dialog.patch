+.studio-upload-dialog .dialog-message-container, .studio-upload-field textarea { scrollbar-width:thin; scrollbar-color:transparent transparent; }
+.studio-upload-dialog .dialog-message-container:hover, .studio-upload-field textarea:hover { scrollbar-color:var(--vscode-scrollbarSlider-background) transparent; }
