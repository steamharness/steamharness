diff --git a/src/vs/workbench/services/secrets/electron-browser/secretStorageService.ts b/src/vs/workbench/services/secrets/electron-browser/secretStorageService.ts
--- a/src/vs/workbench/services/secrets/electron-browser/secretStorageService.ts
+++ b/src/vs/workbench/services/secrets/electron-browser/secretStorageService.ts
@@ -7,6 +7,7 @@
 import { isLinux } from '../../../../base/common/platform.js';
 import Severity from '../../../../base/common/severity.js';
 import { localize } from '../../../../nls.js';
+import { CommandsRegistry } from '../../../../platform/commands/common/commands.js';
 import { IDialogService } from '../../../../platform/dialogs/common/dialogs.js';
 import { IEncryptionService, KnownStorageProvider, PasswordStoreCLIOption, isGnome, isKwallet } from '../../../../platform/encryption/common/encryptionService.js';
 import { INativeEnvironmentService } from '../../../../platform/environment/common/environment.js';
@@ -103,3 +104,18 @@ export class NativeSecretStorageService extends BaseSecretStorageService {
 }
 
 registerSingleton(ISecretStorageService, NativeSecretStorageService, InstantiationType.Delayed);
+
+// Bot credential entry must not silently fall back to volatile or basic-text storage.
+CommandsRegistry.registerCommand('studio.internalCanPersistBotCredentials', async accessor => {
+	const encryption = accessor.get(IEncryptionService);
+	const storage = accessor.get(ISecretStorageService);
+	if (!await encryption.isEncryptionAvailable()) {
+		return false;
+	}
+	const provider = await encryption.getKeyStorageProvider();
+	if (provider !== KnownStorageProvider.keychainAccess && provider !== KnownStorageProvider.dplib && !isGnome(provider) && !isKwallet(provider)) {
+		return false;
+	}
+	await storage.keys?.(); // Resolve the lazy storage type without reading any values.
+	return storage.type === 'persisted';
+});
