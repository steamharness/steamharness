@@ -0,0 +1,81 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+.studio-account-menu {
+	box-sizing: border-box;
+	width: 312px;
+	max-width: calc(100vw - 16px);
+	max-height: calc(100vh - 24px);
+	overflow: auto;
+	border: 1px solid var(--vscode-widget-border, var(--vscode-menu-border, transparent));
+	border-radius: 8px;
+	background: var(--vscode-menu-background);
+	color: var(--vscode-menu-foreground);
+	box-shadow: 0 4px 18px var(--vscode-widget-shadow);
+	font-size: 12px;
+	letter-spacing: 0;
+	user-select: text;
+	scrollbar-width: thin;
+	scrollbar-color: transparent transparent;
+}
+
+.studio-account-menu:hover {
+	scrollbar-color: var(--vscode-scrollbarSlider-background) transparent;
+}
+
+.studio-account-menu [hidden] { display: none !important; }
+.studio-account-menu button { font: inherit; color: inherit; cursor: pointer; }
+.studio-account-menu button:focus-visible { outline: 1px solid var(--vscode-focusBorder); outline-offset: -2px; }
+
+.studio-account-heading {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	gap: 12px;
+	padding: 10px 12px 0 16px;
+	color: var(--vscode-descriptionForeground);
+	font-size: 11px;
+	font-weight: 600;
+}
+
+.studio-account-close {
+	display: grid;
+	place-items: center;
+	width: 24px;
+	height: 24px;
+	padding: 0;
+	border: 0;
+	border-radius: 4px;
+	background: transparent;
+}
+
+.studio-account-close:hover { background: var(--vscode-toolbar-hoverBackground); }
+.studio-account-identity { display: flex; align-items: flex-start; gap: 12px; padding: 12px 16px; }
+.studio-account-avatar { display: grid; place-items: center; flex: 0 0 44px; width: 44px; height: 44px; overflow: hidden; border-radius: 50%; background: var(--vscode-toolbar-hoverBackground); }
+.studio-account-avatar img { width: 100%; height: 100%; object-fit: cover; }
+.studio-account-avatar > .codicon { font-size: 26px; color: var(--vscode-descriptionForeground); }
+.studio-account-details { min-width: 0; flex: 1; }
+.studio-account-name { font-size: 14px; font-weight: 600; line-height: 20px; overflow-wrap: anywhere; }
+.studio-account-email { margin-top: 2px; color: var(--vscode-descriptionForeground); line-height: 18px; overflow-wrap: anywhere; }
+.studio-account-status { display: flex; align-items: baseline; gap: 6px; margin-top: 7px; line-height: 17px; overflow-wrap: anywhere; }
+.studio-account-status::before { content: ''; flex: 0 0 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--vscode-descriptionForeground); }
+.studio-account-status[data-status='authenticated']::before { background: var(--vscode-testing-iconPassed); }
+.studio-account-status[data-status='checking']::before { background: var(--vscode-progressBar-background); }
+.studio-account-status[data-status='expired']::before, .studio-account-status[data-status='error']::before { background: var(--vscode-editorWarning-foreground); }
+.studio-account-server { display: flex; align-items: flex-start; gap: 8px; margin: 0 16px 12px; color: var(--vscode-descriptionForeground); line-height: 18px; }
+.studio-account-server > .codicon { flex: 0 0 16px; margin-top: 1px; }
+.studio-account-server > span:last-child { min-width: 0; overflow-wrap: anywhere; }
+.studio-account-error { margin: 0 16px 12px; color: var(--vscode-errorForeground); line-height: 18px; overflow-wrap: anywhere; }
+.studio-account-actions { padding: 6px; border-top: 1px solid var(--vscode-menu-separatorBackground); }
+.studio-account-action { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 36px; padding: 8px 10px; border: 0; border-radius: 4px; background: transparent; text-align: left; }
+.studio-account-action > .codicon { flex: 0 0 16px; }
+.studio-account-action-label { min-width: 0; flex: 1; overflow-wrap: anywhere; line-height: 18px; }
+.studio-account-action:hover { background: var(--vscode-list-hoverBackground); }
+.studio-account-action:disabled, .studio-account-action[aria-disabled='true'] { opacity: 0.6; cursor: default; }
+.studio-account-action.studio-account-signout { width: calc(100% - 12px); margin: 0 6px 6px; border-top: 1px solid var(--vscode-menu-separatorBackground); border-radius: 0 0 4px 4px; color: var(--vscode-errorForeground); }
+
+@media (prefers-reduced-motion: reduce) {
+	.studio-account-menu .codicon-modifier-spin { animation: none; }
+}
