{
  "name": "studio-workstation",
  "version": "0.1.0",
  "private": true,
  "description": "An independent workstation built on VS Code OSS.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "setup": "node scripts/studio.mjs setup",
    "prepare:studio": "node scripts/studio.mjs prepare",
    "electron": "node scripts/studio.mjs electron",
    "build:extension": "node scripts/build-extension.mjs",
    "watch:extension": "node scripts/build-extension.mjs --watch",
    "build": "node scripts/studio.mjs build",
    "watch": "node scripts/studio.mjs watch",
    "dev": "node scripts/studio.mjs dev",
    "dev:web": "node scripts/studio.mjs web",
    "dev:workflow": "node scripts/studio.mjs workflow",
    "demo": "node scripts/studio.mjs workflow:web",
    "doctor": "node scripts/studio.mjs doctor",
    "typecheck": "tsc --noEmit -p extensions/studio-workstation/tsconfig.json && tsc --noEmit -p extensions/studio-workstation/webview/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:studio-control-live": "node tests/studio-control-live.mjs",
    "test:analysis-live": "node tests/studio-analysis-live.mjs",
    "test:start-ui": "node tests/start-page-ui.mjs",
    "test:mode-ui": "node tests/studio-mode-ui.mjs",
    "test:account-menu-ui": "node tests/account-menu-ui.mjs",
    "test:settings-ui": "node tests/settings-ui.mjs",
    "test:create-live": "node tests/project-create-live.mjs",
    "test:desktop": "node scripts/studio.mjs test:desktop",
    "test:assistant-ui": "node tests/assistant-workspace-desktop-ui.mjs",
    "test:conversation-ui": "node tests/conversation-ui.mjs",
    "test:conversation-clipboard-ui": "node tests/conversation-clipboard-desktop-ui.mjs",
    "test:conversation-server-ui": "node tests/conversation-server-ui.mjs",
    "test:connection-ui": "node tests/connection-desktop-ui.mjs",
    "test:workflow-ui": "node tests/workflow-ui.mjs",
    "test:workflow-desktop-ui": "node tests/workflow-desktop-ui.mjs",
    "test:kanban-ui": "node tests/kanban-ui.mjs",
    "test:kanban-desktop-ui": "node tests/kanban-desktop-ui.mjs",
    "test:resources-ui": "node tests/resources-desktop-ui.mjs",
    "test:resource-cards-ui": "node tests/resource-cards-desktop-ui.mjs",
    "test:trace-ui": "node tests/trace-desktop-ui.mjs",
    "test:trace-agent-ui": "node tests/trace-agent-ui.mjs",
    "test:trace-assistant-ui": "node tests/trace-assistant-ui.mjs",
    "test:info-ui": "node tests/info-desktop-ui.mjs",
    "test:document-preview-ui": "node tests/document-preview-desktop-ui.mjs",
    "test:document-preview-docx-ui": "node tests/document-preview-docx-ui.mjs",
    "test:document-preview-pptx-ui": "node tests/document-preview-pptx-ui.mjs",
    "test:scrollbars-ui": "node tests/scrollbars-ui.mjs",
    "test:cli-toolbar-ui": "node tests/cli-toolbar-ui.mjs",
    "test:cli-quick-parameters-ui": "node tests/cli-quick-parameters-ui.mjs",
    "test:project-language-ui": "node tests/project-language-desktop-ui.mjs",
    "test:localization-ui": "node tests/localization-desktop-ui.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@steamharness/project-card-metadata": "file:../shared/project-card-metadata",
    "@vscode/codicons": "0.0.45",
    "@vscode/l10n": "^0.0.18",
    "chart.js": "4.5.1",
    "dompurify": "3.3.1",
    "docx-preview": "0.4.1",
    "import-meta-resolve": "4.2.0",
    "jsonc-parser": "3.3.1",
    "marked": "17.0.1",
    "katex": "0.19.0",
    "libheif-js": "1.23.5",
    "pdfjs-dist": "6.4.299",
    "pptxviewjs": "1.1.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "tsx": "4.23.0",
    "@types/node": "^24.0.0",
    "@types/katex": "^0.16.8",
    "vscode-api": "npm:@types/vscode@1.140.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "jsdom": "26.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
