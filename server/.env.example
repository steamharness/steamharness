# Local development only. Copy to .env; never commit the resulting file.
WORKFLOW_SERVER_ADMIN_KEY=replace-with-admin-key
WORKFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WORKFLOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password
WORKFLOW_AUTH_COOKIE_SECRET=replace-with-cookie-secret
WORKFLOW_SERVER_PORT=7126
WORKFLOW_API_PUBLIC_BASE_URL=
WORKFLOW_SERVER_DATA_DIR=
WORKFLOW_REPO_ROOT=
WORKFLOW_DATABASE_URL=postgresql://workflow:replace-with-password@127.0.0.1:7125/workflow
WORKFLOW_POSTGRES_PASSWORD=replace-with-postgres-password
# Object storage: the Server keeps objects on its own disk, so a checkout runs
# with no object-storage credentials at all. WORKFLOW_LOCAL_STORAGE_ROOT defaults
# to <data root>/object-storage, and avatar URLs are minted from
# WORKFLOW_API_PUBLIC_BASE_URL, so that is the value that matters here.
# WORKFLOW_STORAGE_DRIVER only accepts `local`; any other backend is a private
# deployment concern and is rejected at startup.
WORKFLOW_STORAGE_DRIVER=
WORKFLOW_LOCAL_STORAGE_ROOT=
