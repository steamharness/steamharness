# Local development only. Copy to .env; never commit the resulting file.
STEAMHARNESS_SERVER_ADMIN_KEY=replace-with-admin-key
STEAMHARNESS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
STEAMHARNESS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password
STEAMHARNESS_AUTH_COOKIE_SECRET=replace-with-cookie-secret
STEAMHARNESS_SERVER_PORT=7126
STEAMHARNESS_API_PUBLIC_BASE_URL=
STEAMHARNESS_SERVER_DATA_DIR=
STEAMHARNESS_REPO_ROOT=
STEAMHARNESS_DATABASE_URL=postgresql://steamharness:replace-with-password@127.0.0.1:7125/steamharness
STEAMHARNESS_POSTGRES_PASSWORD=replace-with-postgres-password
# Development automatically starts a loopback memory service and supplies its
# URL/token. Set AUTOSTART=0 to manage that service yourself, or DISABLED=1 to
# turn memory off entirely. An explicit URL always selects an external service.
STEAMHARNESS_SERVER_MEMORY_AUTOSTART=1
STEAMHARNESS_SERVER_MEMORY_DISABLED=0
STEAMHARNESS_SERVER_MEMORY_URL=
STEAMHARNESS_SERVER_MEMORY_TOKEN=
# Defaults to <Server data root>/memory; relative paths use the Server root.
STEAMHARNESS_MEMORY_DATA_DIR=
# Optional dedicated extraction model. Manual memory works without a model.
STEAMHARNESS_MEMORY_MODEL_BASE_URL=
STEAMHARNESS_MEMORY_MODEL_API_KEY=
STEAMHARNESS_MEMORY_MODEL=
# Object storage: the Server keeps objects on its own disk, so a checkout runs
# with no object-storage credentials at all. STEAMHARNESS_LOCAL_STORAGE_ROOT defaults
# to <data root>/object-storage, and avatar URLs are minted from
# STEAMHARNESS_API_PUBLIC_BASE_URL, so that is the value that matters here.
# STEAMHARNESS_STORAGE_DRIVER only accepts `local`; any other backend is a private
# deployment concern and is rejected at startup.
STEAMHARNESS_STORAGE_DRIVER=
STEAMHARNESS_LOCAL_STORAGE_ROOT=

# Optional per-process PostgreSQL pool limit and reverse-proxy bind address
# STEAMHARNESS_SERVER_DATABASE_POOL_MAX=2
# STEAMHARNESS_SERVER_HOST=127.0.0.1

# Default service links: dev (localhost), alpha, main. Explicit URLs take priority.
# STEAMHARNESS_SERVICE_CHANNEL=dev
