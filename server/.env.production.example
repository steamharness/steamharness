# Production values are GitLab CI/CD Variables scoped to production.
# Use this file only as a variable-name reference for manual deployments.
WORKFLOW_SERVER_ADMIN_KEY=replace-with-admin-key
WORKFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WORKFLOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password
WORKFLOW_AUTH_COOKIE_SECRET=replace-with-cookie-secret
WORKFLOW_SERVER_PORT=7130
WORKFLOW_RELEASE_CHANNEL=stable
WORKFLOW_RELEASE_STORAGE_ROOT=/srv/workflow-release
WORKFLOW_SERVER_DATA_DIR=
WORKFLOW_REPO_ROOT=
WORKFLOW_DOCS_ROOT=
WORKFLOW_DOCS_PORT=7132
WORKFLOW_DOCS_HOST=127.0.0.1
WORKFLOW_PUBLIC_BASE_URL=https://wf.example.com
WORKFLOW_API_PUBLIC_BASE_URL=https://wfapi.example.com
WORKFLOW_HOOKS_PUBLIC_BASE_URL=https://wfhooks.example.com
WORKFLOW_DOCS_PUBLIC_BASE_URL=https://wfdocs.example.com
WORKFLOW_DOCS_API_PUBLIC_BASE_URL=https://wfapi.example.com
WORKFLOW_DATABASE_URL=postgresql://workflow:replace-with-password@127.0.0.1:7125/workflow
WORKFLOW_POSTGRES_PASSWORD=replace-with-postgres-password
# Object storage: objects live on this host under WORKFLOW_LOCAL_STORAGE_ROOT.
# Alpha and stable each get their own disk, so a channel whose artifacts must
# stay readable from the other needs a shared WORKFLOW_LOCAL_STORAGE_ROOT rather
# than a different backend. WORKFLOW_STORAGE_DRIVER only accepts `local`.
WORKFLOW_STORAGE_DRIVER=
WORKFLOW_LOCAL_STORAGE_ROOT=

# Alpha reuses the PostgreSQL database and object-storage root above, while CI
# overrides only these isolated runtime values:
# WORKFLOW_RELEASE_CHANNEL=alpha
# WORKFLOW_SERVER_PORT=7140
# WORKFLOW_SERVER_DATA_DIR=/srv/workflow-release/server-data/alpha
