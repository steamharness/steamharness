# Production values are GitLab CI/CD Variables scoped to production.
# Use this file only as a variable-name reference for manual deployments.
STEAMHARNESS_SERVER_ADMIN_KEY=replace-with-admin-key
STEAMHARNESS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
STEAMHARNESS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password
STEAMHARNESS_AUTH_COOKIE_SECRET=replace-with-cookie-secret
STEAMHARNESS_SERVER_PORT=7130
STEAMHARNESS_RELEASE_CHANNEL=stable
# Use alpha for alpha service links; stable is an alias of main.
# STEAMHARNESS_SERVICE_CHANNEL=main
STEAMHARNESS_RELEASE_STORAGE_ROOT=/srv/steamharness-release
STEAMHARNESS_SERVER_DATA_DIR=
STEAMHARNESS_REPO_ROOT=
STEAMHARNESS_DOCS_ROOT=
STEAMHARNESS_DOCS_PORT=7132
STEAMHARNESS_DOCS_HOST=127.0.0.1
STEAMHARNESS_PUBLIC_BASE_URL=https://steamharness.example.com
STEAMHARNESS_API_PUBLIC_BASE_URL=https://api.steamharness.example.com
STEAMHARNESS_HOOKS_PUBLIC_BASE_URL=https://hooks.steamharness.example.com
STEAMHARNESS_DOCS_PUBLIC_BASE_URL=https://docs.steamharness.example.com
STEAMHARNESS_DOCS_API_PUBLIC_BASE_URL=https://api.steamharness.example.com
STEAMHARNESS_DATABASE_URL=postgresql://steamharness:replace-with-password@127.0.0.1:7125/steamharness
STEAMHARNESS_POSTGRES_PASSWORD=replace-with-postgres-password
# Object storage: objects live on this host under STEAMHARNESS_LOCAL_STORAGE_ROOT.
# Alpha and stable each get their own disk, so a channel whose artifacts must
# stay readable from the other needs a shared STEAMHARNESS_LOCAL_STORAGE_ROOT rather
# than a different backend. STEAMHARNESS_STORAGE_DRIVER only accepts `local`.
STEAMHARNESS_STORAGE_DRIVER=
STEAMHARNESS_LOCAL_STORAGE_ROOT=

# Alpha reuses the PostgreSQL database and object-storage root above, while CI
# overrides only these isolated runtime values:
# STEAMHARNESS_RELEASE_CHANNEL=alpha
# STEAMHARNESS_SERVER_PORT=7140
# STEAMHARNESS_SERVER_DATA_DIR=/srv/steamharness-release/server-data/alpha
