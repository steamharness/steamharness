{
  "name": "@steamharness/server",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "pnpm:devPreinstall": "node scripts/install-guard.mjs",
    "check:boundaries": "node scripts/check-repository-boundaries.mjs",
    "check:secrets": "node scripts/check-secret-files.mjs",
    "check:production-env": "node scripts/check-production-env.mjs",
    "check:alpha-schema": "node scripts/check-alpha-schema.mjs",
    "build": "tsup --config tsup.config.ts && node scripts/generate-build-info.mjs",
    "build:all": "pnpm build && pnpm build:web",
    "dev": "node scripts/dev.mjs",
    "start:local": "node scripts/dev.mjs --no-hmr",
    "build:web": "pnpm -C web build",
    "typecheck:web": "pnpm -C web typecheck",
    "test:web": "pnpm -C web test",
    "coverage": "vitest run --coverage",
    "migrate:workspace-projects": "node scripts/migrate-workspace-projects.mjs",
    "deploy": "pnpm build && node scripts/deploy.mjs start",
    "deploy:start": "node scripts/deploy.mjs start",
    "deploy:stop": "node scripts/deploy.mjs stop",
    "deploy:status": "node scripts/deploy.mjs status",
    "recover:services": "node scripts/recover-services.mjs",
    "recover:stable": "node scripts/recover-stable.mjs",
    "deploy:stable": "node scripts/deploy-stable.mjs",
    "deploy:alpha": "node scripts/deploy-alpha.mjs deploy",
    "deploy:alpha:recover": "node scripts/deploy-alpha.mjs recover",
    "deploy:alpha:stop": "node scripts/deploy-alpha.mjs stop",
    "deploy:alpha:status": "node scripts/deploy-alpha.mjs status",
    "build:runtime": "node scripts/build-runtime.mjs",
    "deploy:ecs": "node scripts/deploy-ecs.mjs",
    "migrate:ecs": "node scripts/migrate-ecs.mjs",
    "deploy:launchd:print": "node scripts/launchd.mjs print",
    "deploy:launchd:install": "node scripts/launchd.mjs install",
    "deploy:launchd:uninstall": "node scripts/launchd.mjs uninstall",
    "deploy:launchd:status": "node scripts/launchd.mjs status",
    "docs:start": "node scripts/docs-server.mjs start",
    "docs:serve": "node scripts/docs-server.mjs serve",
    "docs:stop": "node scripts/docs-server.mjs stop",
    "docs:status": "node scripts/docs-server.mjs status",
    "docs:launchd:print": "node scripts/docs-launchd.mjs print",
    "docs:launchd:install": "node scripts/docs-launchd.mjs install",
    "docs:launchd:uninstall": "node scripts/docs-launchd.mjs uninstall",
    "docs:launchd:status": "node scripts/docs-launchd.mjs status",
    "start": "node dist/index.js",
    "test": "pnpm test:server && pnpm test:scripts && pnpm test:web",
    "test:server": "tsx --conditions=development --test --test-reporter=spec --test-concurrency=2 src/__tests__/*.test.ts src/routes/__tests__/*.test.ts",
    "test:scripts": "node --test --test-reporter=spec scripts/__tests__/*.test.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:web",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@steamharness/i18n": "workspace:*",
    "@steamharness/kanban-project": "workspace:*",
    "@steamharness/project-card-metadata": "workspace:*",
    "@steamharness/project-dependencies": "workspace:*",
    "@steamharness/project-info": "workspace:*",
    "@steamharness/project-types": "workspace:*",
    "@steamharness/project-upload": "workspace:*",
    "@steamharness/runtime-compatibility": "workspace:*",
    "@steamharness/workflow-ids": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "ipaddr.js": "1.9.1",
    "pg": "^8.20.0",
    "tar": "^7.5.14",
    "unzipper": "^0.12.3",
    "steamharness": "0.2.4-20260922009",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@steamharness/cli": "0.2.4-20260909003",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/unzipper": "^0.10.11",
    "cross-env": "^10.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "semver": "^7.7.4",
    "vitest": "^4.1.7"
  }
}
