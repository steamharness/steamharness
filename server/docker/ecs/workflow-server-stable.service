[Unit]
Description=Workflow Code Stable Server
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT__/deployments/server/stable/current
EnvironmentFile=-__ROOT__/runtime/stable.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=WORKFLOW_RELEASE_CHANNEL=stable
Environment=WORKFLOW_RELEASE_STORAGE_ROOT=__ROOT__
Environment=WORKFLOW_RELEASE_METADATA_DIR=__ROOT__/deployments/server/stable/current/.release-metadata
Environment=WORKFLOW_SERVER_PORT=7130
Environment=PORT=7130
Environment=WORKFLOW_SERVER_DATA_DIR=__ROOT__/server-data/stable
ExecStart=__ROOT__/deployments/server/stable/current/.node/bin/node --import __ROOT__/compose/loopback.mjs __ROOT__/deployments/server/stable/current/dist/index.js
StandardOutput=append:__ROOT__/server-data/stable/stdout.log
StandardError=append:__ROOT__/server-data/stable/stderr.log
Restart=on-failure
RestartSec=5
MemoryMax=420M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
