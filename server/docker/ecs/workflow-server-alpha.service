[Unit]
Description=SteamHarness Alpha Server
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT__/deployments/server/alpha/current
EnvironmentFile=-__ROOT__/runtime/alpha.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=192
Environment=STEAMHARNESS_RELEASE_CHANNEL=alpha
Environment=STEAMHARNESS_RELEASE_STORAGE_ROOT=__ROOT__
Environment=STEAMHARNESS_RELEASE_METADATA_DIR=__ROOT__/deployments/server/alpha/current/.release-metadata
Environment=STEAMHARNESS_SERVER_PORT=7140
Environment=PORT=7140
Environment=STEAMHARNESS_SERVER_DATA_DIR=__ROOT__/server-data/alpha
ExecStart=__ROOT__/deployments/server/alpha/current/.node/bin/node --import __ROOT__/compose/loopback.mjs __ROOT__/deployments/server/alpha/current/dist/index.js
StandardOutput=append:__ROOT__/server-data/alpha/stdout.log
StandardError=append:__ROOT__/server-data/alpha/stderr.log
Restart=on-failure
RestartSec=5
MemoryMax=360M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
