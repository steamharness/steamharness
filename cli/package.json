{
  "name": "@steamharness/cli",
  "version": "0.1.1",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "bin": {
    "steamharness": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check:boundaries": "node scripts/check-repository-boundaries.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsup --config tsup.config.ts && node scripts/build-web.mjs && node scripts/build-project-templates.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "coverage": "pnpm build && vitest run --coverage",
    "test:scripts": "node --test --test-reporter=spec scripts/__tests__/*.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:feature": "node scripts/feature-release.mjs tag",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "import-meta-resolve": "4.2.0",
    "tsx": "^4.21.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "steamharness": "^0.1.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "1.1.8",
    "@steamharness/auth-config": "workspace:*",
    "@steamharness/i18n": "workspace:*",
    "@steamharness/kanban-project": "workspace:*",
    "@steamharness/openai-responses": "workspace:*",
    "@steamharness/project-card-metadata": "workspace:*",
    "@steamharness/project-dependencies": "workspace:*",
    "@steamharness/project-info": "workspace:*",
    "@steamharness/project-upload": "workspace:*",
    "@steamharness/repository-boundary": "workspace:*",
    "@steamharness/runtime-compatibility": "workspace:*",
    "@steamharness/workflow-ids": "workspace:*",
    "@steamharness/workflow-mcp": "workspace:*",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vscode/codicons": "0.0.45",
    "dompurify": "3.3.1",
    "esbuild": "0.28.2",
    "marked": "17.0.1",
    "semver": "^7.7.4",
    "steamharness": "0.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "@steamharness/project-configuration": "workspace:*",
    "@steamharness/project-access": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steamharness/steamharness.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/steamharness/steamharness#readme",
  "bugs": {
    "url": "https://github.com/steamharness/steamharness/issues"
  }
}
