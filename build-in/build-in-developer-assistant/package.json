{
  "name": "Project Assistant",
  "version": "0.1.9",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "scripts": {
    "build": "node scripts/builtin-release.mjs verify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "agent-tool-contract": "node scripts/agent-tool-contract.mjs --fix",
    "runtime-api-index": "node scripts/runtime-api-index.mjs --fix",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:build": "node scripts/builtin-release.mjs build",
    "release:assemble": "node scripts/builtin-release.mjs assemble",
    "release:verify": "node scripts/builtin-release.mjs verify-distribution"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@steamharness/cli": "link:../../cli",
    "semver": "^7.7.4",
    "tar": "^7.5.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "steamharness": "link:../../harness",
    "yaml": "^2.9.0"
  }
}
