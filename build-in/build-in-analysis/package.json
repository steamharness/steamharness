{
  "id": "6cbe3c24-2707-4f31-a553-94edbe866eb1",
  "name": "Studio Analysis",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:scripts": "vitest run scripts/__tests__",
    "test:ui": "node tests/dashboard-ui.mjs"
  },
  "devDependencies": {
    "@steamharness/cli": "link:../../cli",
    "steamharness": "link:../../harness",
    "chart.js": "4.5.1",
    "esbuild": "0.28.2",
    "lucide": "0.468.0",
    "playwright": "1.61.1",
    "vitest": "4.1.10"
  },
  "steamHarness": {
    "projectInfo": {
      "localizedNames": {
        "zh-CN": "Studio 分析",
        "en": "Studio Analysis"
      },
      "declarations": [
        "multilingual"
      ],
      "platformSupport": {
        "mode": "agnostic"
      }
    },
    "projectCard": {
      "icon": "chart-column",
      "iconBackgroundColor": "#0f766e"
    },
    "entries": [
      {
        "entryId": "main",
        "type": "kanban",
        "name": "Studio Analysis",
        "root": ".",
        "entry": "index.html",
        "databases": [],
        "configuration": "configuration.json"
      }
    ],
    "defaultEntry": "main"
  }
}
