{
  "id": "7afb5837-251e-4938-bae4-83f8569d9d6b",
  "name": "@steamharness/pi-agent-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.1"
  },
  "scripts": {
    "web": "steamharness web .",
    "dev": "steamharness run .",
    "inspect": "steamharness structure .",
    "run:json": "steamharness json .",
    "workspace:upload": "steamharness workspace upload .",
    "workspace:publish": "steamharness workspace publish ."
  },
  "devDependencies": {
    "@steamharness/cli": "link:../../../cli",
    "steamharness": "link:../../.."
  },
  "steamHarness": {
    "projectInfo": {},
    "entries": [
      {
        "entryId": "main",
        "type": "conversation",
        "name": "@steamharness/pi-agent-workflow",
        "root": ".",
        "entry": "index.ts",
        "databases": [
          {
            "alias": "data",
            "host": "local",
            "permissions": {
              "kv": {
                "read": {
                  "mode": "all"
                },
                "write": {
                  "mode": "all"
                }
              },
              "knowledge": {
                "read": {
                  "mode": "all"
                },
                "write": {
                  "mode": "all"
                }
              }
            }
          }
        ],
        "configuration": "configuration.json"
      }
    ],
    "defaultEntry": "main"
  }
}
