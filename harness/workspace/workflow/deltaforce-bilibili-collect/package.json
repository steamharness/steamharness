{
  "id": "e48aae56-7e59-45f5-adc3-f30e9c65d23c",
  "name": "@steamharness/deltaforce-bilibili-collect-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "bilibili-api-ts": "^11.11.2",
    "ffmpeg-static": "^5.3.0"
  },
  "scripts": {
    "dev": "steamharness run .",
    "inspect": "steamharness structure .",
    "run:json": "steamharness json .",
    "workspace:upload": "steamharness workspace upload .",
    "workspace:publish": "steamharness workspace publish ."
  },
  "devDependencies": {
    "@steamharness/cli": "link:../../../cli",
    "steamharness": "link:../../.."
  },
  "steamHarness": {
    "projectInfo": {},
    "entries": [
      {
        "entryId": "main",
        "type": "workflow",
        "name": "@steamharness/deltaforce-bilibili-collect-workflow",
        "root": ".",
        "entry": "index.ts",
        "databases": [
          {
            "alias": "data",
            "host": "local",
            "permissions": {
              "kv": {
                "read": {
                  "mode": "all"
                },
                "write": {
                  "mode": "all"
                }
              },
              "knowledge": {
                "read": {
                  "mode": "all"
                },
                "write": {
                  "mode": "all"
                }
              }
            }
          }
        ],
        "configuration": "configuration.json"
      }
    ],
    "defaultEntry": "main"
  }
}
