{
  "id": "1e43f54c-f4eb-431f-8033-dc2bf0c19903",
  "name": "@steamharness/openai-agents-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./*": "./*.ts"
  },
  "dependencies": {
    "@openai/agents": "^0.11.5",
    "openai": "^6.39.0",
    "zod": "^4.1.13"
  },
  "scripts": {
    "dev": "steamharness run .",
    "inspect": "steamharness structure .",
    "run:json": "steamharness json .",
    "workspace:upload": "steamharness workspace upload .",
    "workspace:publish": "steamharness workspace publish ."
  },
  "devDependencies": {
    "@steamharness/cli": "link:../../../cli",
    "steamharness": "link:../../.."
  },
  "steamHarness": {
    "projectInfo": {},
    "entries": [
      {
        "entryId": "main",
        "type": "conversation",
        "name": "@steamharness/openai-agents-workflow",
        "root": ".",
        "entry": "index.ts",
        "databases": [
          {
            "alias": "data",
            "host": "local",
            "permissions": {
              "kv": {
                "read": {
                  "mode": "all"
                },
                "write": {
                  "mode": "all"
                }
              },
              "knowledge": {
                "read": {
                  "mode": "all"
                },
                "write": {
                  "mode": "all"
                }
              }
            }
          }
        ],
        "configuration": "configuration.json"
      }
    ],
    "defaultEntry": "main"
  }
}
